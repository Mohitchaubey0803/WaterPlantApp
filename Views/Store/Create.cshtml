@model WaterPlantApp.Models.Store
@{
    ViewData["Title"] = "Add New Store";
}
<div class="section">
    <a asp-action="Manage" class="back-link">← Back to Manage</a>
    <h2 class="section-title">Add New Store</h2>
    <div class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-group full">
                    <label asp-for="StoreName"></label>
                    <input asp-for="StoreName" placeholder="e.g. AquaPure - Sector 10" />
                    <span asp-validation-for="StoreName" class="val-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StoreCode"></label>
                    <input asp-for="StoreCode" placeholder="AP-005" />
                    <span asp-validation-for="StoreCode" class="val-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StoreType"></label>
                    <select asp-for="StoreType">
                        <option value="Retail">Retail</option>
                        <option value="Wholesale">Wholesale</option>
                        <option value="Distribution">Distribution</option>
                    </select>
                </div>
                <div class="form-group full">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" placeholder="Street / Building / Plot No." />
                    <span asp-validation-for="Address" class="val-error"></span>
                </div>
                <div class="form-group"><label asp-for="City"></label><input asp-for="City" placeholder="Gurugram" /></div>
                <div class="form-group"><label asp-for="State"></label><input asp-for="State" placeholder="Haryana" /></div>
                <div class="form-group"><label asp-for="PinCode"></label><input asp-for="PinCode" placeholder="122001" /></div>
                <div class="form-group"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" placeholder="+91-9876540000" /></div>
                <div class="form-group"><label asp-for="EmailAddress"></label><input asp-for="EmailAddress" placeholder="store@aquapure.in" /></div>
                <div class="form-group"><label asp-for="ManagerName"></label><input asp-for="ManagerName" placeholder="Manager full name" /></div>
                <div class="form-group"><label asp-for="ManagerPhone"></label><input asp-for="ManagerPhone" placeholder="+91-9876540000" /></div>
                <div class="form-group"><label asp-for="OperatingHours"></label><input asp-for="OperatingHours" placeholder="9:00 AM - 8:00 PM" /></div>
                <div class="form-group"><label asp-for="WaterCapacityLtrs"></label><input asp-for="WaterCapacityLtrs" type="number" placeholder="10000" /></div>
                <div class="form-group full"><label asp-for="Description"></label><textarea asp-for="Description" rows="3" placeholder="Brief description…"></textarea></div>
                <div class="form-group">
                    <label>Active</label>
                    <select asp-for="IsActive">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">💾 Save Store</button>
                <a asp-action="Manage" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
