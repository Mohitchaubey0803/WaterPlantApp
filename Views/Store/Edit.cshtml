@model WaterPlantApp.Models.Store
@{
    ViewData["Title"] = "Edit Store";
}
<div class="section">
    <a asp-action="Manage" class="back-link">← Back to Manage</a>
    <h2 class="section-title">Edit: @Model.StoreName</h2>
    <div class="form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StoreId" />
            <input type="hidden" asp-for="CreatedAt" />
            <div class="form-grid">
                <div class="form-group full"><label asp-for="StoreName"></label><input asp-for="StoreName" /><span asp-validation-for="StoreName" class="val-error"></span></div>
                <div class="form-group"><label asp-for="StoreCode"></label><input asp-for="StoreCode" /></div>
                <div class="form-group">
                    <label asp-for="StoreType"></label>
                    <select asp-for="StoreType">
                        <option value="Retail">Retail</option>
                        <option value="Wholesale">Wholesale</option>
                        <option value="Distribution">Distribution</option>
                    </select>
                </div>
                <div class="form-group full"><label asp-for="Address"></label><input asp-for="Address" /></div>
                <div class="form-group"><label asp-for="City"></label><input asp-for="City" /></div>
                <div class="form-group"><label asp-for="State"></label><input asp-for="State" /></div>
                <div class="form-group"><label asp-for="PinCode"></label><input asp-for="PinCode" /></div>
                <div class="form-group"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" /></div>
                <div class="form-group"><label asp-for="EmailAddress"></label><input asp-for="EmailAddress" /></div>
                <div class="form-group"><label asp-for="ManagerName"></label><input asp-for="ManagerName" /></div>
                <div class="form-group"><label asp-for="ManagerPhone"></label><input asp-for="ManagerPhone" /></div>
                <div class="form-group"><label asp-for="OperatingHours"></label><input asp-for="OperatingHours" /></div>
                <div class="form-group"><label asp-for="WaterCapacityLtrs"></label><input asp-for="WaterCapacityLtrs" type="number" /></div>
                <div class="form-group full"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea></div>
                <div class="form-group">
                    <label>Active</label>
                    <select asp-for="IsActive">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">💾 Update Store</button>
                <a asp-action="Manage" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
