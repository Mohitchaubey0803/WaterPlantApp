@model WaterPlantApp.Models.Store
@{
    ViewData["Title"] = Model.StoreName;
}
<div class="detail-page">
    <a asp-action="Index" class="back-link">← Back to All Stores</a>
    <div class="detail-hero">
        <div class="detail-hero-top">
            <div>
                <span class="type-badge type-@Model.StoreType" style="margin-bottom:8px;display:inline-block;">@Model.StoreCode</span>
                <h1>@Model.StoreName</h1>
                <p style="opacity:.8;margin-top:4px;">@Model.StoreType Store</p>
            </div>
            <span class="badge @(Model.IsActive ? "badge-active" : "badge-inactive")" style="font-size:13px;padding:6px 14px;">
                @(Model.IsActive ? "✓ Open" : "Closed")
            </span>
        </div>
    </div>
    <div class="detail-grid">
        <div class="detail-card">
            <h4>📍 Location</h4>
            <p style="font-size:15px;margin-bottom:6px;font-weight:500;">@Model.Address</p>
            <p style="color:#555f6d;font-size:14px;">@Model.City, @Model.State — @Model.PinCode</p>
            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
            {
                <a href="https://maps.google.com/?q=@Model.Latitude,@Model.Longitude" target="_blank" class="btn btn-primary btn-sm" style="margin-top:12px;display:inline-block;">🗺️ Open in Maps</a>
            }
        </div>
        <div class="detail-card">
            <h4>📞 Contact</h4>
            <div style="margin-bottom:10px;">
                <p style="font-size:11px;color:#9aa3ae;margin-bottom:2px;">Store Phone</p>
                <a href="tel:@Model.PhoneNumber" style="font-size:17px;font-weight:700;color:#0069c0;text-decoration:none;">@Model.PhoneNumber</a>
            </div>
            @if (!string.IsNullOrEmpty(Model.EmailAddress))
            {
                <div style="margin-bottom:10px;">
                    <p style="font-size:11px;color:#9aa3ae;margin-bottom:2px;">Email</p>
                    <a href="mailto:@Model.EmailAddress" style="font-size:14px;color:#0069c0;text-decoration:none;">@Model.EmailAddress</a>
                </div>
            }
            <p style="font-size:11px;color:#9aa3ae;margin-bottom:2px;">Manager</p>
            <p style="font-size:14px;font-weight:500;">@Model.ManagerName @(string.IsNullOrEmpty(Model.ManagerPhone) ? "" : "· " + Model.ManagerPhone)</p>
        </div>
        <div class="detail-card">
            <h4>⏰ Operations</h4>
            @if (!string.IsNullOrEmpty(Model.OperatingHours))
            {
                <p style="font-size:17px;font-weight:700;color:#003d7a;margin-bottom:8px;">@Model.OperatingHours</p>
            }
            @if (Model.WaterCapacityLtrs.HasValue)
            {
                <p style="font-size:11px;color:#9aa3ae;margin-bottom:2px;">Water Capacity</p>
                <p style="font-size:20px;font-weight:800;color:#003d7a;">@Model.WaterCapacityLtrs.Value.ToString("N0") <span style="font-size:14px;font-weight:400;">Litres</span></p>
            }
        </div>
        <div class="detail-card">
            <h4>ℹ️ About</h4>
            <p style="font-size:14px;color:#555f6d;line-height:1.7;">@(Model.Description ?? "No description available.")</p>
        </div>
    </div>
    @if (Model.StoreProducts.Any())
    {
        <div class="detail-card" style="margin-bottom:1.5rem;">
            <h4>🛍️ Available Products</h4>
            <table class="products-table">
                <thead>
                    <tr><th>Product</th><th>Size</th><th>Price</th><th>Stock</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var sp in Model.StoreProducts.Where(sp => sp.Product.IsActive))
                    {
                        <tr>
                            <td style="font-weight:500;">@sp.Product.ProductName</td>
                            <td>@sp.Product.SizeLtrs L</td>
                            <td style="font-weight:700;color:#003d7a;">Rs. @sp.Product.PricePerUnit</td>
                            <td>@sp.StockQty units</td>
                            <td><span class="badge @(sp.IsAvailable ? "badge-active" : "badge-inactive")">@(sp.IsAvailable ? "Available" : "Out of Stock")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
